name: Jules PR Review

# Custom reviewer: replaces community action with file-list-first diff strategy
# to avoid 80KB truncation. Reads existing PR comments for context. Sets
# jules/review commit status based on parsed verdict (block → failure).
#
# Output format expected from Jules:
#   ## Summary
#   ## Strengths
#   ## Findings
#     ### [BLOCKING] - path:line — desc
#     ### [WARN] - path:line — desc
#     ### [NIT] - path:line — desc
#   ## Verdict
#   VERDICT: approve | comment | block
#
# To skip review on this PR, add the label "jules-override".

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  issue_comment:
    types: [created]

concurrency:
  group: jules-review-${{ github.event.pull_request.number || github.event.issue.number }}
  cancel-in-progress: true

jobs:
  review:
    if: >-
      github.event_name == 'pull_request' &&
      github.event.pull_request.user.login != 'google-labs-jules[bot]'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      pull-requests: write
      contents: read
      statuses: write
    steps:
      - name: Fork check
        id: fork-check
        shell: bash
        env:
          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}
          BASE_REPO: ${{ github.event.pull_request.base.repo.full_name }}
        run: |
          if [ "$HEAD_REPO" != "$BASE_REPO" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        if: steps.fork-check.outputs.skip != 'true'
        with:
          fetch-depth: 0

      - name: Checkout helper scripts (trusted base branch)
        if: steps.fork-check.outputs.skip != 'true'
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ github.event.pull_request.base.ref }}
          sparse-checkout: |
            .github/scripts
          path: _helpers

      - name: Prepare review prompt
        id: prepare
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            // Propagate fork skip from the fork-check step
            if ('${{ steps.fork-check.outputs.skip }}' === 'true') {
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            const pr = context.payload.pull_request;
            const baseRef = pr.base.ref;
            const headSha = pr.head.sha;

            // Check bypass label
            const { data: labels } = await github.rest.issues.listLabelsOnIssue({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: pr.number,
            });
            if (labels.some(l => l.name === 'jules-override')) {
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            // Skip automated PRs (Dependabot, GitHub Actions, Mergify, Renovate bots)
            const botAuthors = ['dependabot[bot]', 'github-actions[bot]', 'mergify[bot]', 'renovate[bot]'];
            if (botAuthors.includes(pr.user.login) || pr.head.ref.startsWith('dependabot/')) {
              core.info(`Automated PR by ${pr.user.login} (branch: ${pr.head.ref}) — skipping review`);
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            const files = await github.paginate(github.rest.pulls.listFiles, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: pr.number,
            });

            const fileSummary = files.map(f => ({
              path: f.filename, status: f.status,
              additions: f.additions, deletions: f.deletions,
            }));

            // Skip trivial changes — lockfile-only, docs-only, or tiny diffs
            const totalChanges = files.reduce((s, f) => s + f.additions + f.deletions, 0);
            const nonLockfile = files.filter(f =>
              !f.filename.endsWith('package-lock.json') &&
              !f.filename.endsWith('yarn.lock') &&
              !f.filename.endsWith('.gitignore') &&
              !f.filename.includes('/migrations/')
            );
            if (files.length <= 2 && totalChanges < 50) {
              core.info(`Trivial diff (${files.length} files, ${totalChanges} lines) — skipping review`);
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }
            if (nonLockfile.length === 0) {
              core.info('Lockfile-only or migration-only changes — skipping review');
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            // Fetch existing comments
            const allIssueComments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: pr.number,
              per_page: 100,
            });

            // Cross-session dedup: skip if a review for this SHA was already posted
            const existingReview = allIssueComments.find(c =>
              c.body?.includes('<!-- jules-pr-reviewer -->') &&
              c.body?.includes(`head_sha: ${headSha}`)
            );
            if (existingReview) {
              core.info('Review already posted for this HEAD SHA — skipping');
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            const fs = require('fs');
            const classifierPath = './_helpers/.github/scripts/jules-comment-classifier.cjs';
            let priorFeedback = '';
            let priorReviews = '';
            let hasWalkthrough = false;
            if (fs.existsSync(classifierPath)) {
              const { classifyAndFilter } = require(classifierPath);
              const result = await classifyAndFilter(github, context.repo.owner, context.repo.repo, pr.number, {
                includeReviewComments: true,
                includeReviews: false,
                includeThreads: false,
                includeWalkthrough: false,
                maxComments: 10,
                maxBodyLength: 300,
              });
              priorFeedback = result.priorFeedback;
              priorReviews = result.priorReviews;
              hasWalkthrough = result.hasWalkthrough;
            } else {
              core.warning('jules-comment-classifier.cjs not found in base branch — proceeding without prior comment context');
            }

             // Load repo-specific instructions from base branch (trusted)
            let reviewRules = '';
            for (const path of ['.jules/INSTRUCTIONS.md', '.github/jules-review-rules.md']) {
              try {
                const { data } = await github.rest.repos.getContent({
                  owner: context.repo.owner, repo: context.repo.repo,
                  path, ref: baseRef,
                });
                reviewRules = Buffer.from(data.content, 'base64').toString('utf8');
                break;
              } catch (e) { /* file is optional */ }
            }

            // Linked issue analysis
            let linkedIssue = '';
            const issueMatch = pr.body?.match(/(?:Fixes|Closes|Resolves|Fix|Close|Resolve)\s+#(\d+)/i);
            if (issueMatch) {
              try {
                const { data: issue } = await github.rest.issues.get({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: parseInt(issueMatch[1]),
                });
                linkedIssue = `## Linked Issue\n\n#${issue.number}: ${issue.title}\n${issue.body?.slice(0, 1000) || ''}`;
              } catch (e) { /* issue may be private or deleted */ }
            }

            const prompt = [
              `## Code Review Request`,
              ``,
              `Repository: ${context.repo.owner}/${context.repo.repo}`,
              `Title: ${pr.title}`,
              `Target branch: ${baseRef}`,
              `PR head branch: ${pr.head.ref}`,
              `PR head SHA: ${headSha}`,
              `Files changed: ${files.length} (${files.reduce((s, f) => s + f.additions + f.deletions, 0)} +/-)`,
              ``,
              `## Changed files (names only — no content)`,
              JSON.stringify(fileSummary, null, 2),
              ...(priorFeedback ? [``, `## Existing PR comments`, priorFeedback] : []),
              ...(priorReviews ? [``, `## Existing review comments`, priorReviews] : []),
              ...(reviewRules ? [``, `## Repository-specific review rules`, reviewRules] : []),
              ...(linkedIssue ? [``, linkedIssue] : []),
              ``,
              `## Your task`,
              `This is a read-only code review. Do NOT create any pull requests or modify code.`,
              `Review the code changes using the file-list-first approach:`,
              `1. Review the file list above — identify relevant files`,
              `2. Group them by directory or thematic area (e.g., API, Database, Frontend)`,
              `3. For each relevant file, run: git diff origin/${baseRef}...HEAD -- <filepath>`,
              `4. Read existing PR/review comments above — build on prior context`,
              `5. If a linked issue is provided, assess whether this PR addresses it`,
              `6. Run security analysis using pre-installed tools:`,
              `   - Python: \`ruff check --select ALL .\` (ruff is pre-installed)`,
              `   - JavaScript: \`eslint .\` (eslint is pre-installed)`,
              `   - Include any security findings classified by severity`,
              `7. Examine logic, edge cases, and consistency`,
              ``,
              `## Review Criteria (in priority order)`,
              `1. **Correctness** — logic errors, unhandled edge cases, race conditions, incorrect API usage, data validation flaws`,
              `2. **Security** — injection attacks, insecure data storage, insufficient access controls, secrets exposure`,
              `3. **Efficiency** — performance bottlenecks, unnecessary computations, memory leaks, inefficient data structures`,
              `4. **Maintainability** — readability, modularity, adherence to language idioms and style guides (PEP 8, Google style, etc.)`,
              `5. **Testing** — adequate unit/integration/e2e tests, coverage, edge case handling, test quality`,
              `6. **Performance** — performance under expected load, bottlenecks, optimizations`,
              `7. **Scalability** — how code scales with growing user base or data volume`,
              `8. **Modularity and Reusability** — code organization, modularity, reusability, refactoring opportunities`,
              `9. **Error Logging and Monitoring** — effective error logging, monitoring mechanisms for production health`,
              ``,
              `## Severity Levels (strict — assign to every finding)`,
              `🔴 Critical — production failure, security breach, data corruption. MUST fix before merge.`,
              `🟠 High — significant problems, bugs, performance degradation. Should fix before merge.`,
              `🟡 Medium — deviation from best practices, technical debt. Consider fixing.`,
              `🟢 Low — minor, stylistic, typos, documentation. Author discretion.`,
              ``,
              ...(hasWalkthrough ? [] : [
                ``,
                `## Bonus: PR Walkthrough`,
                `No walkthrough exists for this PR. After completing the review above,`,
                `add a walkthrough section after the REVIEW block. Include:`,
                `1. **Narrative summary** — what changed and why (2-3 paragraphs)`,
                `2. **Key architectural decisions** — why this approach was chosen`,
                `3. **Diagrams** — \`\`\`mermaid blocks where applicable`,
                `4. **Thematic groupings** — group changed files by area`,
                `Separate the walkthrough from the review with:`,
                `<!-- walkthrough_start -->`,
                `## Walkthrough`,
                `(walkthrough content here)`,
                `<!-- walkthrough_end -->`,
              ]),
              ``,
              `## Output format`,
              `Produce the review EXACTLY in this structure. Keep every element shown below`,
              `including HTML comments and XML-like tags — they are required for parsing.`,
              `Replace placeholders (e.g. <description>) with your analysis.`,
              ``,
              '## Summary',
              '<1-2 paragraphs — what this PR does and whether it is sound>',
              '',
              '## Strengths',
              '- <point form: what is done well>',
              '',
              '## Findings',
              'If no issues found, write: "No significant findings."',
              '',
              '### 🔴 Critical - <path/file.ext:line> — <description>',
              '<MUST fix before merge — production failure, security breach, data corruption. If suggestion:>',
              '````',
              '```suggestion',
              '<replacement code>',
              '```',
              '````',
              '<details>',
              '<summary>🤖 AI reasoning</summary>',
              '<brief explanation of the logic that produced this finding>',
              '</details>',
              '<!-- FINDING severity="critical" file="src/auth.py" line="42" reason="security" -->',
              '',
              '### 🟠 High - <path/file.ext:line> — <description>',
              '<should fix — significant problems, bugs, performance degradation. If suggestion:>',
              '````',
              '```suggestion',
              '<code>',
              '```',
              '````',
              '<details><summary>🤖 AI reasoning</summary><explanation></details>',
              '<!-- FINDING severity="high" file="..." line="..." reason="..." -->',
              '',
              '### 🟡 Medium - <path/file.ext:line> — <description>',
              '<deviation from best practices, technical debt. Consider fixing.>',
              '<!-- FINDING severity="medium" file="..." line="..." -->',
              '',
              '### 🟢 Low - <path/file.ext:line> — <description>',
              '<minor, stylistic, typos, documentation. Author discretion.>',
              '<!-- FINDING severity="low" file="..." line="..." -->',
              '',
              '## Truncation',
              'If nearing timeout or output exceeds length limits, truncate gracefully.',
              'Summarize remaining issues. Set verdict block if critical remain, comment if minor.',
              'Add: <!-- meta-prompt: truncated due to limits -->',
              '',
              '## Verdict',
              '[VERDICT]: <approve|comment|block>',
              '',
              '<!-- verdict: approve | comment | block -->',
              '',
              '<details>',
              '<summary>🤖 Prompt for AI Agents — implement all per-line changes</summary>',
              '',
              'This PR review identified findings that need to be addressed.',
              'Each per-line comment above includes a specific issue with a code suggestion.',
              'To implement all changes:',
              '1. Read each per-line comment with its ```suggestion block',
              '2. Apply each suggestion at the specified file and line',
              '3. Verify no regressions are introduced',
              '4. Commit and push the fixes',
              '',
              'Or apply the jules-fix label to this PR for an automated fix PR.',
              '',
              '</details>',
            ].join('\n');

            const payload = {
              prompt,
              sourceContext: {
                source: `sources/github/${context.repo.owner}/${context.repo.repo}`,
                githubRepoContext: { startingBranch: pr.head.ref },
              },
            };

            const fs = require('fs');
            fs.writeFileSync('/tmp/jules-review-payload.json', JSON.stringify(payload));
            fs.appendFileSync(process.env.GITHUB_OUTPUT, `head_sha=${headSha}\n`);
            core.info(`Payload written for PR #${pr.number}`);

      - name: Skip (fork or bypass label)
        if: steps.prepare.outputs.skip == 'true'
        shell: bash
        run: echo "Skipped — fork PR or jules-override label present"

      - name: Create Jules session
        if: steps.prepare.outputs.skip != 'true'
        id: create
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
        run: |
          retry_curl() {
            local max_retries=3 base_delay=5 attempt=1
            local response rc
            while [ $attempt -le $max_retries ]; do
              response=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 "$@" 2>&1)
              rc=$?
              if [ $rc -eq 0 ]; then echo "$response"; return 0; fi
              if [ $attempt -lt $max_retries ]; then sleep $((base_delay * attempt)); fi
              attempt=$((attempt + 1))
            done
            echo "$response"
            return 1
          }

          set +e
          RESPONSE=$(retry_curl -X POST "https://jules.googleapis.com/v1alpha/sessions" \
            -H "Content-Type: application/json" \
            -H "X-Goog-Api-Key: ${JULES_API_KEY}" \
            -d @/tmp/jules-review-payload.json)
          CURL_EXIT=$?
          set -e

          if [ $CURL_EXIT -ne 0 ]; then
            ERROR_CODE=$(echo "$RESPONSE" | jq -r '.error.code // "0"')
            ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // ""')
            if [ "$ERROR_CODE" = "429" ] || echo "$ERROR_MSG" | grep -qiE 'quota|limit|exhaust|exceeded|capacity|daily'; then
              echo "quota_exhausted=true" >> "$GITHUB_OUTPUT"
              echo "⚠️ Session cap reached — no session created."
              exit 0
            elif [ "$ERROR_CODE" = "403" ]; then
              echo "::warning::HTTP 403 — may be permissions, not quota: $ERROR_MSG"
              exit 1
            fi
            echo "Error: $RESPONSE"
            exit 1
          fi

          SESSION_NAME=$(echo "$RESPONSE" | jq -r '.name // empty')
          SESSION_ID=$(echo "$RESPONSE" | jq -r '.id // empty')
          STATE=$(echo "$RESPONSE" | jq -r '.state // empty')

          if [ -z "$SESSION_NAME" ] && [ -z "$SESSION_ID" ]; then
            echo "Error: $RESPONSE"
            exit 1
          fi

          echo "session_name=$SESSION_NAME" >> "$GITHUB_OUTPUT"
          echo "session_id=$SESSION_ID" >> "$GITHUB_OUTPUT"
          echo "Session created: $SESSION_NAME (state: $STATE)"

      - name: Notify session cap reached
        if: steps.create.outputs.quota_exhausted == 'true'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.pull_request.number,
              body: '⚠️ **Jules session cap reached (15/day).**\n\nNo review was created for this PR. Re-open or sync the PR tomorrow to trigger auto-review again.\n\n<!-- jules-quota-exhausted -->',
            });

      - name: Poll for completion
        if: steps.prepare.outputs.skip != 'true' && steps.create.outputs.quota_exhausted != 'true'
        id: poll
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
          SESSION_NAME: ${{ steps.create.outputs.session_name }}
          SESSION_ID: ${{ steps.create.outputs.session_id }}
        run: |
          SESSION_RESOURCE="${SESSION_NAME:-sessions/${SESSION_ID}}"
          # 90 attempts × 15s = 22.5 min (job timeout is 30 min, leaving room
          # for setup + post-review).  Increased from 60 (15 min) because Jules
          # sessions on large PRs frequently exceed 15 minutes.
          MAX_ATTEMPTS=90
          FETCH_ACTIVITIES() {
            curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
              "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}/activities?pageSize=100" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>/dev/null || true
          }
          SAVE_OUTPUT() {
            local acts
            acts="$(FETCH_ACTIVITIES)"
            if [ -n "$acts" ]; then
              echo "$acts" | jq -r '[
                (.activities // [])[]
                | select(.agentMessaged.agentMessage != null)
                | .agentMessaged.agentMessage
              ] | join("\n\n---\n\n") // ""' > /tmp/jules-review-output.txt
              local msg_count
              msg_count=$(jq -r '[(.activities // [])[] | select(.agentMessaged.agentMessage != null)] | length' <<< "$acts" 2>/dev/null || echo 0)
              PARTIAL_OUTPUT=true
              if [ "$msg_count" -gt 0 ]; then
                echo "partial_output=true" >> "$GITHUB_OUTPUT"
                echo "Captured $msg_count agent messages from session"
              else
                echo "partial_output=false" >> "$GITHUB_OUTPUT"
              fi
            else
              echo "partial_output=false" >> "$GITHUB_OUTPUT"
              PARTIAL_OUTPUT=false
            fi
          }

          for i in $(seq 1 $MAX_ATTEMPTS); do
            sleep 15
            RESPONSE=''
            for get_attempt in 1 2; do
              if RESPONSE=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
                "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}" \
                -H "X-Goog-Api-Key: ${JULES_API_KEY}"); then
                break
              fi
              if [ "$get_attempt" -eq 1 ]; then sleep 5; fi
            done
            if [ -z "$RESPONSE" ]; then
              echo "Attempt $i/$MAX_ATTEMPTS — session GET failed after retry"
              continue
            fi
            STATE=$(echo "$RESPONSE" | jq -r '.state // "UNKNOWN"')

            if [ "$STATE" = "COMPLETED" ] || [ "$STATE" = "FAILED" ]; then
              echo "session_state=$STATE" >> "$GITHUB_OUTPUT"
              SAVE_OUTPUT
              echo "Session finished ($STATE)"
              exit 0
            fi
            echo "Attempt $i/$MAX_ATTEMPTS — state: $STATE"
          done

          # Timeout — attempt one final activities fetch to capture partial
          # output.  The session may have produced review content even if it
          # hasn't reached COMPLETED state yet.
          echo "session_state=TIMEOUT" >> "$GITHUB_OUTPUT"
          SAVE_OUTPUT
          if [ "${PARTIAL_OUTPUT:-false}" = "true" ]; then
            echo "Poll timed out but captured partial output"
          else
            echo "Review timed out after $((MAX_ATTEMPTS * 15)) seconds." > /tmp/jules-review-output.txt
          fi

      - name: Post review and set commit status
        if: always() && steps.prepare.conclusion == 'success' && steps.prepare.outputs.skip != 'true' && steps.create.outputs.quota_exhausted != 'true'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            const fs = require('fs');
            const reviewText = fs.readFileSync('/tmp/jules-review-output.txt', 'utf8');
            const prNumber = context.payload.pull_request.number;
            const headSha = '${{ steps.prepare.outputs.head_sha }}';
            const sessionState = '${{ steps.poll.outputs.session_state }}';
            const sessionName = '${{ steps.create.outputs.session_name }}';
            const sessionId = '${{ steps.create.outputs.session_id }}';
            const hasPartialOutput = '${{ steps.poll.outputs.partial_output }}' === 'true';

            // Split walkthrough from review before parsing
            const wtStart = '<!-- walkthrough_start -->';
            const wtEnd = '<!-- walkthrough_end -->';
            const reviewTextParts = reviewText.split(wtStart);
            const mainReview = reviewTextParts[0].trim();
            let walkthroughText = '';
            if (reviewTextParts.length > 1) {
              const afterStart = reviewTextParts[1];
              const endIdx = afterStart.indexOf(wtEnd);
              walkthroughText = endIdx !== -1
                ? afterStart.slice(0, endIdx).trim()
                : afterStart.trim();
            }

            // Parse verdict from structured output (review portion only)
            const verdictMatch = mainReview.match(/\[VERDICT\]:\s*(approve|comment|block)|<!--\s*verdict:\s*(approve|comment|block)\s*-->/i);
            const verdict = verdictMatch ? (verdictMatch[1] || verdictMatch[2]).toLowerCase() : null;

            // Determine commit status — fail closed
            let statusState = 'failure';
            let statusDesc = 'Review failed';
            if (sessionState === 'COMPLETED' && verdict === 'approve') {
              statusState = 'success';
              statusDesc = 'Approved';
            } else if (sessionState === 'COMPLETED' && verdict === 'comment') {
              statusState = 'success';
              statusDesc = 'Comments provided';
            } else if (sessionState === 'COMPLETED' && verdict === 'block') {
              statusState = 'failure';
              statusDesc = 'Blocking issues found';
            } else if (sessionState === 'COMPLETED' && !verdict) {
              statusState = 'failure';
              statusDesc = 'Review completed (no verdict)';
            } else if (sessionState === 'FAILED') {
              statusState = 'failure';
              statusDesc = 'Jules session failed';
            } else if (sessionState === 'TIMEOUT' && hasPartialOutput) {
              statusState = 'pending';
              statusDesc = 'Partial review (session still running)';
            } else if (sessionState === 'TIMEOUT') {
              statusState = 'failure';
              statusDesc = 'Review timed out';
            }

            // Set jules/review commit status
            try {
              await github.rest.repos.createCommitStatus({
                owner: context.repo.owner,
                repo: context.repo.repo,
                sha: headSha,
                state: statusState,
                context: 'jules/review',
                description: statusDesc,
              });
            } catch (e) {
              core.warning(`Failed to set commit status: ${e.message}`);
            }

            // ── Parse per-line findings ──────────────────────────────────
            // Primary: FINDING markers (structured, emitted by the prompt).
            // Fallback: heading-based parsing (### 🔴 Critical - file:line)
            //           for when Jules doesn't emit FINDING markers.
            const findingRegex = /<!--\s*FINDING\s+severity="([^"]+)"\s+file="([^"]+)"\s+line="?(\d+)"?(?:\s+reason="([^"]*)")?\s*-->/gi;
            const comments = [];
            let findingMatch;
            const seen = new Set();

            // Primary: FINDING markers
            while ((findingMatch = findingRegex.exec(mainReview)) !== null) {
              const [, severity, file, line, reason] = findingMatch;
              const key = `${file}:${line}`;
              if (seen.has(key)) continue;
              seen.add(key);

              const heading = `### ${severity === 'critical' ? '🔴' : severity === 'high' ? '🟠' : severity === 'medium' ? '🟡' : '🟢'} ${severity.charAt(0).toUpperCase() + severity.slice(1)} - ${file}:${line}`;
              const startIdx = mainReview.indexOf(heading);
              const endIdx = mainReview.indexOf('<!-- FINDING', startIdx + 1);
              const findingBody = startIdx !== -1
                ? mainReview.slice(startIdx, endIdx !== -1 ? endIdx : undefined).trim()
                : '';

              comments.push({
                path: file,
                line: parseInt(line),
                body: findingBody || `${heading}\n\nSee review summary for details.`,
              });
            }

            // Fallback: heading-based parsing when no FINDING markers found.
            // Matches patterns like:
            //   ### 🔴 Critical - src/auth.py:42
            //   ### 🟠 High — path/file.ext:line — description
            //   ### [BLOCKING] - path:line — desc
            //   ### [WARN] - path:line — desc
            if (comments.length === 0) {
              const emojiMap = { '🔴': 'critical', '🟠': 'high', '🟡': 'medium', '🟢': 'low' };
              const bracketMap = { 'BLOCKING': 'critical', 'WARN': 'medium', 'NIT': 'low', 'HIGH': 'high', 'CRITICAL': 'critical', 'MEDIUM': 'medium', 'LOW': 'low' };
              // Match: ### [emoji|bracket] [severity] [-|—] file:line
              const headingRegex = /^###\s+(?:([🔴🟠🟡🟢])|(?:\[([A-Z]+)\]))\s*(?:[A-Za-z]+\s*)?[-—]\s*(.+?):(\d+)\s*(?:[-—]\s*(.*))?$/gmi;
              let hMatch;
              while ((hMatch = headingRegex.exec(mainReview)) !== null) {
                const emoji = hMatch[1];
                const bracket = hMatch[2];
                const file = hMatch[3].trim();
                const line = hMatch[4];
                const key = `${file}:${line}`;
                if (seen.has(key)) continue;
                seen.add(key);

                const severity = emoji ? emojiMap[emoji] : (bracketMap[bracket] || 'medium');

                // Extract the finding body (from this heading to the next ### or end)
                const lineIdx = hMatch.index;
                const nextHeadingIdx = mainReview.indexOf('###', lineIdx + 1);
                const findingBody = nextHeadingIdx !== -1
                  ? mainReview.slice(lineIdx, nextHeadingIdx).trim()
                  : mainReview.slice(lineIdx).trim();

                comments.push({
                  path: file,
                  line: parseInt(line),
                  body: findingBody,
                });
              }
              core.info(`Fallback heading-based parsing extracted ${comments.length} comments`);
            }

            // ── Build review body ─────────────────────────────────────────
            const isPartial = sessionState === 'TIMEOUT' && hasPartialOutput;
            const sessionResource = sessionName || (sessionId ? `sessions/${sessionId}` : '');
            const deferredNotice = isPartial && sessionResource
              ? `\n\n<!-- jules-review-deferred session="${sessionResource}" sha="${headSha}" -->\n\n> ⏳ **Partial review — Jules session is still running.**\n> The session has not completed yet, but partial output was captured.\n> A maintainer can post \`/jules-post-review\` on this PR to re-check the session\n> and post the full review once it completes.`
              : '';
            const timeoutNotice = sessionState === 'TIMEOUT' && !hasPartialOutput && sessionResource
              ? `\n\n<!-- jules-review-deferred session="${sessionResource}" sha="${headSha}" -->\n\n> ⚠️ **Review timed out — Jules session is still running.**\n> No output was captured before the poll expired.\n> A maintainer can post \`/jules-post-review\` on this PR to re-check the session\n> and post the review once it completes.`
              : '';

            const body = `<!-- jules-pr-reviewer -->\n<!-- head_sha: ${headSha} -->\n${sessionResource ? `<!-- jules-session: ${sessionResource} -->` : ''}\n\n${mainReview}${deferredNotice}${timeoutNotice}`;

            let reviewEvent = 'COMMENT';
            if (sessionState === 'COMPLETED' && verdict === 'approve') reviewEvent = 'APPROVE';
            else if (sessionState === 'COMPLETED' && verdict === 'block') reviewEvent = 'REQUEST_CHANGES';

            // Stale SHA guard: re-fetch PR head to ensure no new commits arrived
            // during polling. If the SHA is stale, don't post inline comments or
            // formal approve/request-changes against outdated work.
            let currentSha = headSha;
            try {
              const currentPr = (await github.rest.pulls.get({
                owner: context.repo.owner, repo: context.repo.repo,
                pull_number: prNumber,
              })).data;
              currentSha = currentPr.head.sha;
            } catch (e) {
              core.warning(`Could not re-fetch PR for SHA check: ${e.message}`);
            }

            if (currentSha !== headSha) {
              core.warning(`PR head changed during review: was ${headSha}, now ${currentSha} — posting COMMENT only, no inline comments`);
              const staleBody = `⚠️ **Review posted as comment — PR was updated during review.**\n\nThe review session ran against commit \`${headSha}\`, but the PR head is now \`${currentSha}\`. Inline comments and formal approve/block were skipped to avoid targeting outdated code.\n\n${body}`;
              try {
                await github.rest.issues.createComment({
                  owner: context.repo.owner, repo: context.repo.repo,
                  issue_number: prNumber, body: staleBody,
                });
              } catch (e2) {
                core.error(`Failed to post stale-review comment: ${e2.message}`);
              }
            } else {
              try {
                const reviewParams = {
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  pull_number: prNumber,
                  commit_id: headSha,
                  event: reviewEvent,
                  body,
                };
                if (comments.length > 0) {
                  reviewParams.comments = comments;
                }
                await github.rest.pulls.createReview(reviewParams);
                core.info(`Review posted with ${comments.length} per-line comments`);
              } catch (e) {
                core.warning(`PR review failed (${reviewEvent}), falling back to batch comment: ${e.message}`);
                const fallbackBody = `<!-- jules-pr-reviewer -->\n<!-- head_sha: ${headSha} -->\n<!-- intended_review_event: ${reviewEvent} -->\n<!-- review_post_failed: ${e.message.slice(0, 200)} -->\n\n${body}`;
                try {
                  await github.rest.issues.createComment({
                    owner: context.repo.owner,
                    repo: context.repo.repo,
                    issue_number: prNumber,
                    body: fallbackBody,
                  });
                } catch (e2) {
                  core.error(`Both createReview and fallback createComment failed: ${e2.message}`);
                }
              }
            }

            // Post walkthrough as separate issue comment if generated
            if (walkthroughText) {
              try {
                await github.rest.issues.createComment({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: prNumber,
                  body: `<!-- jules-walkthrough -->\n\n${walkthroughText}`,
                });
                core.info('Walkthrough posted as issue comment');
              } catch (e) {
                core.warning(`Failed to post walkthrough: ${e.message}`);
              }
            }

      - name: Upload session output
        if: always() && steps.prepare.conclusion == 'success' && steps.prepare.outputs.skip != 'true' && steps.create.outputs.quota_exhausted != 'true'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: jules-review-${{ github.event.pull_request.number }}
          path: /tmp/jules-review-output.txt
          retention-days: 30

  # ─── Deferred review: handles /jules-post-review comments ────────────────
  # When a review session times out, the review job posts a comment with a
  # <!-- jules-review-deferred session="..." sha="..." --> marker.  A
  # maintainer can later comment /jules-post-review on the PR to re-check
  # the session and post the full review once it has completed.
  # NOTE: force-review uses a distinct <!-- jules-force-review-deferred -->
  # marker so the two workflows do not double-post.  Both trigger on
  # /jules-post-review but only the matching marker is processed.
  post-deferred:
    if: >-
      github.event_name == 'issue_comment' &&
      github.event.issue.pull_request &&
      startsWith(github.event.comment.body, '/jules-post-review') &&
      contains('OWNER,MEMBER,COLLABORATOR', github.event.comment.author_association)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pull-requests: write
      contents: read
      statuses: write
    steps:
      - name: Find deferred review marker and fetch session
        id: find
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            const prNumber = context.payload.issue.number;
            const comments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: prNumber, per_page: 100,
            });

            // Find the most recent deferred review marker
            // Match the full deferred marker form (must include both session and sha attributes),
            // so a malformed or stray pending comment cannot collide with this filter.
            const deferredComment = comments
              .filter(c => /<!--\s*jules-review-deferred\s+session="[^"]+"\s+sha="[^"]+"\s*-->/.test(c.body || ''))
              .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))[0];

            if (!deferredComment) {
              core.info('No deferred review marker found — nothing to post');
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            // Extract session resource and SHA from the marker
            const markerMatch = deferredComment.body.match(
              /<!--\s*jules-review-deferred\s+session="([^"]+)"\s+sha="([^"]+)"\s*-->/
            );
            if (!markerMatch) {
              core.info('Deferred marker malformed — cannot extract session');
              const fs = require('fs');
              fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=true\n');
              return;
            }

            const fs = require('fs');
            fs.appendFileSync(process.env.GITHUB_OUTPUT, 'skip=false\n');
            fs.appendFileSync(process.env.GITHUB_OUTPUT, `session_resource=${markerMatch[1]}\n`);
            fs.appendFileSync(process.env.GITHUB_OUTPUT, `head_sha=${markerMatch[2]}\n`);
            fs.appendFileSync(process.env.GITHUB_OUTPUT, `pr_number=${prNumber}\n`);
            core.info(`Found deferred session: ${markerMatch[1]}`);

      - name: Check session state and fetch activities
        if: steps.find.outputs.skip != 'true'
        id: check
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
          SESSION_RESOURCE: ${{ steps.find.outputs.session_resource }}
        run: |
          RESPONSE=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
            "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}" \
            -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>&1) || {
            echo "session_state=ERROR" >> "$GITHUB_OUTPUT"
            echo "Failed to fetch session state: $RESPONSE" > /tmp/jules-deferred-output.txt
            exit 0
          }
          STATE=$(echo "$RESPONSE" | jq -r '.state // "UNKNOWN"')
          echo "session_state=$STATE" >> "$GITHUB_OUTPUT"
          echo "Session state: $STATE"

          if [ "$STATE" = "COMPLETED" ] || [ "$STATE" = "FAILED" ]; then
            ACTS=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
              "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}/activities?pageSize=100" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}")
            echo "$ACTS" | jq -r '[
              (.activities // [])[]
              | select(.agentMessaged.agentMessage != null)
              | .agentMessaged.agentMessage
            ] | if length == 0 then "Review unavailable" else join("\n\n---\n\n") end' > /tmp/jules-deferred-output.txt
            echo "output_ready=true" >> "$GITHUB_OUTPUT"
          else
            echo "output_ready=false" >> "$GITHUB_OUTPUT"
            echo "Session is still $STATE — not ready for posting." > /tmp/jules-deferred-output.txt
          fi

      - name: Post deferred review
        if: steps.find.outputs.skip != 'true' && steps.check.outputs.output_ready == 'true'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        env:
          HEAD_SHA: ${{ steps.find.outputs.head_sha }}
          SESSION_STATE: ${{ steps.check.outputs.session_state }}
          SESSION_RESOURCE: ${{ steps.find.outputs.session_resource }}
        with:
          script: |
            const fs = require('fs');
            const reviewText = fs.readFileSync('/tmp/jules-deferred-output.txt', 'utf8');
            const prNumber = parseInt(process.env.PR_NUMBER || '${{ steps.find.outputs.pr_number }}');
            const headSha = process.env.HEAD_SHA;
            const sessionState = process.env.SESSION_STATE;
            const sessionResource = process.env.SESSION_RESOURCE;

            const pr = (await github.rest.pulls.get({
              owner: context.repo.owner, repo: context.repo.repo,
              pull_number: prNumber,
            })).data;

            // SHA guard: if the PR was updated since the deferred marker was
            // posted, the review is stale — don't post inline comments against
            // the wrong commit.
            if (pr.head.sha !== headSha) {
              await github.rest.issues.createComment({
                owner: context.repo.owner, repo: context.repo.repo,
                issue_number: prNumber,
                body: `⚠️ **Deferred review skipped — PR was updated.**\n\nThe review session was recorded against commit \`${headSha}\`, but the PR head is now \`${pr.head.sha}\`. The review may be outdated. Please trigger a new review for the current commit.`,
              });
              core.info(`SHA mismatch: marker=${headSha}, current=${pr.head.sha} — skipping deferred post`);
              return;
            }

            // FAILED session: post diagnostic comment, not a formal review.
            // Preserve session/SHA for recovery; don't consume the deferred marker.
            if (sessionState === 'FAILED') {
              await github.rest.issues.createComment({
                owner: context.repo.owner, repo: context.repo.repo,
                issue_number: prNumber,
                body: `❌ **Jules review session failed.**\n\nSession: \`${sessionResource}\`\nCommit: \`${headSha}\`\n\nThe session did not complete successfully. Raw output (for evidence):\n\n<details><summary>Session output</summary>\n\n${reviewText.slice(0, 4000)}\n\n</details>\n\nThe deferred review marker is preserved so recovery remains possible.`,
              });
              core.info('Session FAILED — posted diagnostic comment, deferred marker preserved');
              return;
            }

            // Split walkthrough from review
            const wtStart = '<!-- walkthrough_start -->';
            const wtEnd = '<!-- walkthrough_end -->';
            const reviewTextParts = reviewText.split(wtStart);
            const mainReview = reviewTextParts[0].trim();
            let walkthroughText = '';
            if (reviewTextParts.length > 1) {
              const afterStart = reviewTextParts[1];
              const endIdx = afterStart.indexOf(wtEnd);
              walkthroughText = endIdx !== -1
                ? afterStart.slice(0, endIdx).trim()
                : afterStart.trim();
            }

            // Parse verdict
            const verdictMatch = mainReview.match(/\[VERDICT\]:\s*(approve|comment|block)|<!--\s*verdict:\s*(approve|comment|block)\s*-->/i);
            const verdict = verdictMatch ? (verdictMatch[1] || verdictMatch[2]).toLowerCase() : null;

            // Parse per-line findings (primary + fallback)
            const findingRegex = /<!--\s*FINDING\s+severity="([^"]+)"\s+file="([^"]+)"\s+line="?(\d+)"?(?:\s+reason="([^"]*)")?\s*-->/gi;
            const comments = [];
            const seen = new Set();
            let m;
            while ((m = findingRegex.exec(mainReview)) !== null) {
              const [, severity, file, line] = m;
              const key = `${file}:${line}`;
              if (seen.has(key)) continue;
              seen.add(key);
              const heading = `### ${severity === 'critical' ? '🔴' : severity === 'high' ? '🟠' : severity === 'medium' ? '🟡' : '🟢'} ${severity.charAt(0).toUpperCase() + severity.slice(1)} - ${file}:${line}`;
              const startIdx = mainReview.indexOf(heading);
              const endIdx = mainReview.indexOf('<!-- FINDING', startIdx + 1);
              const body = startIdx !== -1
                ? mainReview.slice(startIdx, endIdx !== -1 ? endIdx : undefined).trim()
                : heading;
              comments.push({ path: file, line: parseInt(line), body });
            }

            // Fallback heading-based parsing
            if (comments.length === 0) {
              const emojiMap = { '🔴': 'critical', '🟠': 'high', '🟡': 'medium', '🟢': 'low' };
              const bracketMap = { 'BLOCKING': 'critical', 'WARN': 'medium', 'NIT': 'low', 'HIGH': 'high', 'CRITICAL': 'critical', 'MEDIUM': 'medium', 'LOW': 'low' };
              const headingRegex = /^###\s+(?:([🔴🟠🟡🟢])|(?:\[([A-Z]+)\]))\s*(?:[A-Za-z]+\s*)?[-—]\s*(.+?):(\d+)\s*(?:[-—]\s*(.*))?$/gmi;
              let hMatch;
              while ((hMatch = headingRegex.exec(mainReview)) !== null) {
                const emoji = hMatch[1];
                const bracket = hMatch[2];
                const file = hMatch[3].trim();
                const line = hMatch[4];
                const key = `${file}:${line}`;
                if (seen.has(key)) continue;
                seen.add(key);
                const lineIdx = hMatch.index;
                const nextHeadingIdx = mainReview.indexOf('###', lineIdx + 1);
                const body = nextHeadingIdx !== -1
                  ? mainReview.slice(lineIdx, nextHeadingIdx).trim()
                  : mainReview.slice(lineIdx).trim();
                comments.push({ path: file, line: parseInt(line), body });
              }
              core.info(`Fallback heading-based parsing extracted ${comments.length} comments`);
            }

            // Update commit status
            let statusState = 'failure', statusDesc = 'Review failed';
            if (sessionState === 'COMPLETED' && verdict === 'approve') {
              statusState = 'success'; statusDesc = 'Approved';
            } else if (sessionState === 'COMPLETED' && verdict === 'comment') {
              statusState = 'success'; statusDesc = 'Comments provided';
            } else if (sessionState === 'COMPLETED' && verdict === 'block') {
              statusState = 'failure'; statusDesc = 'Blocking issues found';
            } else if (sessionState === 'COMPLETED' && !verdict) {
              statusState = 'failure'; statusDesc = 'Review completed (no verdict)';
            } else if (sessionState === 'FAILED') {
              statusState = 'failure'; statusDesc = 'Jules session failed';
            }
            try {
              await github.rest.repos.createCommitStatus({
                owner: context.repo.owner, repo: context.repo.repo,
                sha: headSha, state: statusState,
                context: 'jules/review', description: statusDesc,
              });
            } catch (e) {
              core.warning(`Failed to set commit status: ${e.message}`);
            }

            // Post the review
            const body = `<!-- jules-pr-reviewer -->\n<!-- head_sha: ${headSha} -->\n<!-- jules-deferred-review-posted -->\n\n${mainReview}`;
            let reviewEvent = 'COMMENT';
            if (sessionState === 'COMPLETED' && verdict === 'approve') reviewEvent = 'APPROVE';
            else if (sessionState === 'COMPLETED' && verdict === 'block') reviewEvent = 'REQUEST_CHANGES';

            try {
              const reviewParams = {
                owner: context.repo.owner, repo: context.repo.repo,
                pull_number: prNumber, commit_id: headSha,
                event: reviewEvent, body,
              };
              if (comments.length > 0) reviewParams.comments = comments;
              await github.rest.pulls.createReview(reviewParams);
              core.info(`Deferred review posted with ${comments.length} per-line comments`);
            } catch (e) {
              core.warning(`Deferred review failed (${reviewEvent}), falling back to batch comment: ${e.message}`);
              const fallbackBody = `<!-- jules-pr-reviewer -->\n<!-- head_sha: ${headSha} -->\n<!-- jules-deferred-review-posted -->\n<!-- intended_review_event: ${reviewEvent} -->\n<!-- review_post_failed: ${e.message.slice(0, 200)} -->\n\n${mainReview}`;
              try {
                await github.rest.issues.createComment({
                  owner: context.repo.owner, repo: context.repo.repo,
                  issue_number: prNumber, body: fallbackBody,
                });
              } catch (e2) {
                core.error(`Both createReview and fallback createComment failed: ${e2.message}`);
              }
            }

            if (walkthroughText) {
              try {
                await github.rest.issues.createComment({
                  owner: context.repo.owner, repo: context.repo.repo,
                  issue_number: prNumber,
                  body: `<!-- jules-walkthrough -->\n\n${walkthroughText}`,
                });
              } catch (e) {
                core.warning(`Failed to post walkthrough: ${e.message}`);
              }
            }

      - name: Session still running
        if: steps.find.outputs.skip != 'true' && steps.check.outputs.output_ready != 'true'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            const state = '${{ steps.check.outputs.session_state }}';
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.issue.number,
              body: `⏳ **Jules session is still ${state}.**\n\nThe session has not completed yet. Comment \`/jules-post-review\` again later to re-check.\n\n<!-- jules-review-pending -->`,
            });

      - name: No deferred session found
        if: steps.find.outputs.skip == 'true'
        shell: bash
        run: echo "No deferred review marker found — nothing to post"
