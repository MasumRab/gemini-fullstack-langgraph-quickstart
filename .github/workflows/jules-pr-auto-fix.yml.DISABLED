name: Jules Auto-Fix

on:
  pull_request:
    types: [labeled]
  issue_comment:
    types: [created]

concurrency:
  group: jules-fix-${{ github.event.pull_request.number || github.event.issue.number }}
  cancel-in-progress: false

jobs:
  fix:
    if: >
      github.event.label.name == 'jules-fix' ||
      (github.event_name == 'issue_comment' &&
       github.event.issue.pull_request &&
       startsWith(github.event.comment.body, '/jules-fix') &&
       contains('OWNER,MEMBER,COLLABORATOR', github.event.comment.author_association))
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Consume label — prevent duplicate sessions
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.removeLabel({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.pull_request.number,
              name: 'jules-fix',
            }).catch(e => { if (e.status !== 404) throw e; core.info('Label already consumed'); });
      - name: Parse slash command context
        if: github.event_name == 'issue_comment'
        id: parse
        shell: bash
        env:
          COMMENT_BODY: ${{ github.event.comment.body }}
        run: |
          CUSTOM=$(echo "$COMMENT_BODY" | sed 's|^/jules-fix ||')
          {
            echo "custom_instructions<<EOF"
            echo "$CUSTOM"
            echo "EOF"
          } >> "$GITHUB_OUTPUT"

      - name: Fork check
        id: fork-check
        uses: actions/github-script@v7
        with:
          script: |
            let pr;
            if (context.eventName === 'issue_comment') {
              if (!context.payload.issue?.pull_request) {
                core.setOutput('skip', 'true');
                return;
              }
              const { data } = await github.rest.pulls.get({
                owner: context.repo.owner, repo: context.repo.repo,
                pull_number: context.payload.issue.number,
              });
              pr = data;
            } else {
              pr = context.payload.pull_request;
            }
            const sameRepo = pr.head.repo?.full_name === pr.base.repo?.full_name;
            core.setOutput('skip', sameRepo ? 'false' : 'true');
            core.setOutput('pr_number', String(pr.number));
            core.setOutput('head_sha', pr.head.sha);
            core.setOutput('head_ref', pr.head.ref);
            core.setOutput('base_ref', pr.base.ref);

      - uses: actions/checkout@v4
        if: steps.fork-check.outputs.skip != 'true'
        with:
          ref: ${{ steps.fork-check.outputs.head_sha }}
          fetch-depth: 1

      - name: Checkout trusted classifier
        if: steps.fork-check.outputs.skip != 'true'
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.fork-check.outputs.base_ref }}
          path: _helpers
          sparse-checkout: .github/scripts

      - name: Prepare prompt and payload
        id: prepare
        env:
          CUSTOM_INSTRUCTIONS: ${{ steps.parse.outputs.custom_instructions }}
        uses: actions/github-script@v7
        with:
          script: |
            if ('${{ steps.fork-check.outputs.skip }}' === 'true') {
              core.setOutput('skip', 'true');
              return;
            }

            let pr;
            if (context.eventName === 'issue_comment') {
              if (!context.payload.issue?.pull_request) {
                core.setOutput('skip', 'true');
                return;
              }
              const { data } = await github.rest.pulls.get({
                owner: context.repo.owner, repo: context.repo.repo,
                pull_number: context.payload.issue.number,
              });
              pr = data;
            } else {
              pr = context.payload.pull_request;
            }
            const baseRef = pr.base.ref;
            const headRef = pr.head.ref;
            const headSha = pr.head.sha;
            const body = pr.body || '';

            const match = body.match(/^Target:\s*(\S+)/m);
            const target = (match ? match[1] : baseRef);

            if (match && target !== baseRef) {
              core.warning(`PR body says "${target}" but PR targets "${baseRef}"`);
            }

            // Fetch changed file list (names only)
            const files = await github.paginate(github.rest.pulls.listFiles, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: pr.number,
            });

            const fileSummary = files.map(f => ({
              path: f.filename, status: f.status,
              additions: f.additions, deletions: f.deletions,
            }));
            const fileCount = files.length;
            const totalChanges = files.reduce((s, f) => s + f.additions + f.deletions, 0);

            if (totalChanges > 2000) {
              core.warning(`Large diff (${totalChanges} lines) — instructing selective git diff`);
            }

            // Cross-session dedup: skip if auto-fix already started for this SHA.
            const allIssueComments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: pr.number,
              per_page: 100,
            });
            const existingFix = allIssueComments.find(c =>
              c.body?.includes('<!-- jules-auto-fix -->') &&
              c.body?.includes(`head_sha: ${headSha}`)
            );
            if (existingFix) {
              core.info('Auto-fix already started for this HEAD SHA — skipping');
              core.setOutput('skip', 'true');
              return;
            }

            const fs = require('fs');
            const classifierPath = './_helpers/.github/scripts/jules-comment-classifier.cjs';
            let priorFeedback = '';
            let priorReviews = '';
            if (fs.existsSync(classifierPath)) {
              const { classifyAndFilter } = require(classifierPath);
              const result = await classifyAndFilter(github, context.repo.owner, context.repo.repo, pr.number, {
                includeReviewComments: true,
                includeReviews: false,
                includeThreads: false,
                includeWalkthrough: true,
                maxComments: 10,
                maxBodyLength: 300,
              });
              priorFeedback = result.priorFeedback;
              priorReviews = result.priorReviews;
            } else {
              core.warning('jules-comment-classifier.cjs not found in base branch — proceeding without prior comment context');
            }

            // Load repo-specific instructions from base branch (trusted)
            let reviewRules = '';
            for (const path of ['.jules/INSTRUCTIONS.md', '.github/jules-review-rules.md']) {
              try {
                const { data } = await github.rest.repos.getContent({
                  owner: context.repo.owner, repo: context.repo.repo,
                  path, ref: baseRef,
                });
                reviewRules = Buffer.from(data.content, 'base64').toString('utf8');
                break;
              } catch (e) { /* file is optional */ }
            }

            const customInstr = process.env.CUSTOM_INSTRUCTIONS || '';
            let prompt = [
              ...(customInstr ? [`## User instructions`, customInstr, ``] : []),
              `Fix the issue described in this PR. You will create a new PR with the fix.`,
              ``,
              `## ⚠️ IMPORTANT — Plan / Approve Workflow`,
              `Before making ANY code changes, you MUST follow this structured workflow:`,
              ``,
              `1. **Plan Phase**: Analyze the PR, identify the files to change, and create a`,
              `   detailed plan. Post your plan as a **PR comment** with the marker`,
              `   <!-- jules-auto-fix-plan --> at the top. Use this exact template:`,
              ``,
              `   ## 🤖 AI Assistant: Plan of Action`,
              `   I have analyzed the request and propose the following plan.`,
              `   **This plan will not be executed until it is approved by a maintainer.**`,
              ``,
              `   **Resource Estimate:**`,
              `   * **Estimated Tool Calls:** ~[Number]`,
              `   * **Files to Modify:** [Number]`,
              ``,
              `   **Proposed Steps:**`,
              `   - [ ] Step 1: Detailed description of the first action.`,
              `   - [ ] Step 2: ...`,
              ``,
              `   **Current HEAD SHA:** <insert the actual head SHA here>`,
              `   Please review this plan. To approve, comment /approve on this PR.`,
              `   To reject, comment /deny.`,
              ``,
              `2. **Wait for Approval**: After posting the plan, STOP. Do NOT implement the fix`,
              `   in this session. A maintainer will review the plan and comment /approve or /deny.`,
              `   The workflow will start a SEPARATE execution session when /approve is received`,
              `   (only OWNER/MEMBER/COLLABORATOR association is accepted). If /deny is received,`,
              `   the plan is cancelled and <!-- jules-auto-fix-plan-denied --> is posted.`,
              ``,
              `3. **Execute Phase** (in a separate session after /approve): Implement the plan`,
              `   — apply fixes, run tests, commit, and create the PR.`,
              ``,
              `4. **Report Phase**: Post a final summary comment with marker`,
              `   <!-- jules-auto-fix-summary -->.`,
              ``,
              `---`,
              ``,
              ...(reviewRules ? [``, `## Repository-specific instructions`, reviewRules] : []),
              ``,
              `## ${pr.title}`,
              ``,
              body,
              ``,
              `---`,
              `Repository: ${context.repo.owner}/${context.repo.repo}`,
              `Target branch: ${target}`,
              `PR head branch: ${headRef}`,
              `PR head SHA: ${headSha}`,
              `Files changed: ${fileCount} (${totalChanges} +/-)`,
              ``,
              `## Changed files (names only, no content)`,
              JSON.stringify(fileSummary, null, 2),
              ``,
              ...(priorFeedback ? [
                `## Existing PR comments`,
                priorFeedback,
                ``,
              ] : []),
              ...(priorReviews ? [
                `## Existing review comments`,
                priorReviews,
                ``,
              ] : []),
              `## Strategy`,
              `The repo is cloned in your sandbox with the PR head branch (${headRef}) checked out.`,
              `The goal is to apply the requested fix on top of the existing PR code, not rewrite it.`,
              `Do NOT request the full diff at once.`,
              `1. Review the file list above — identify relevant files`,
              `2. Read existing PR/review comments above — build on prior context`,
              `3. Run: git diff origin/${target}...HEAD -- <filepath>`,

              `4. Process files one at a time`,
              `5. Only diff files actually needed for the fix`,
               `6. After making and committing the fix locally, check for late commits:`,
               `   run \`git fetch origin ${target} && git log --oneline HEAD..origin/${target}\``,
               `   If new commits arrived: \`git rebase origin/${target}\`, resolve new conflicts,`,
               `   verify the fix still works, and amend if needed.`,
             ].join('\n');

            const prCreateCmd = [
              '7. Create a new PR with gh (no AUTO_CREATE_PR — you do it):',
              '   - Push your branch: git push origin HEAD',
              '   - Then run:',
              '     gh pr create \\',
              `       --base ${target} \\`,
              `       --head "$(git rev-parse --abbrev-ref HEAD)" \\`,
              `       --title "fix: ${pr.title.replace(/"/g, '\\"')}" \\`,
              `       --body "Fixes #${pr.number}\n\n[Describe the fix]" \\`,
              `       --label jules-auto-fix`,
              '   - Verify the label was applied: gh pr view --json labels',
              '   - Ensure CI checks pass',
            ].join('\n');

            prompt += '\n\n' + prCreateCmd;

            const payload = {
              prompt,
              sourceContext: {
                source: `sources/github/${context.repo.owner}/${context.repo.repo}`,
                githubRepoContext: { startingBranch: headRef },
              },
            };

            // Write payload to file for the curl step
            fs.writeFileSync('/tmp/jules-auto-fix-payload.json', JSON.stringify(payload));
            core.setOutput('target_branch', target);
            core.info(`Payload written to /tmp/jules-payload.json`);

      - name: Invoke Jules via API
        id: create
        if: steps.prepare.outputs.skip != 'true'
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
        run: |
          retry_curl() {
            local attempt response rc
            for attempt in 1 2 3; do
              response=$(curl "$@")
              rc=$?
              if [ $rc -eq 0 ]; then printf '%s' "$response"; return 0; fi
              [ $attempt -eq 3 ] || sleep $((attempt * 5))
            done
            printf '%s' "$response"
            return $rc
          }
          set +e
          RESPONSE=$(retry_curl -sS --fail-with-body --connect-timeout 10 --max-time 60 -X POST "https://jules.googleapis.com/v1alpha/sessions" \
            -H "Content-Type: application/json" \
            -H "X-Goog-Api-Key: ${JULES_API_KEY}" \
            -d @/tmp/jules-auto-fix-payload.json)
          CURL_EXIT=$?
          set -e

          if [ $CURL_EXIT -ne 0 ]; then
            ERROR_CODE=$(echo "$RESPONSE" | jq -r '.error.code // "0"')
            ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // ""')
            if [ "$ERROR_CODE" = "429" ] || echo "$ERROR_MSG" | grep -qi 'quota'; then
              echo "quota_exhausted=true" >> "$GITHUB_OUTPUT"
              echo "⚠️ Session cap reached — no session created."
              exit 0
            fi
            if [ "$ERROR_CODE" = "403" ]; then echo "Warning: Jules API returned 403 (not treated as quota)."; fi
            echo "Error: $RESPONSE"
            exit 1
          fi

          SESSION_NAME=$(echo "$RESPONSE" | jq -r '.name // empty')
          SESSION_ID=$(echo "$RESPONSE" | jq -r '.id // empty')

          if [ -z "$SESSION_NAME" ] && [ -z "$SESSION_ID" ]; then
            echo "Error: $RESPONSE"
            exit 1
          fi

          echo "session_name=$SESSION_NAME" >> "$GITHUB_OUTPUT"
          echo "session_id=$SESSION_ID" >> "$GITHUB_OUTPUT"
          echo "Session created: ${SESSION_NAME:-sessions/${SESSION_ID}}"

      - name: Post session-started marker
        if: steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.skip != 'true'
        uses: actions/github-script@v7
        with:
          script: |
            const headSha = '${{ steps.fork-check.outputs.head_sha }}';
            const sessionName = '${{ steps.create.outputs.session_name }}';
            const sessionId = '${{ steps.create.outputs.session_id }}';
            const sessionResource = sessionName || (sessionId ? `sessions/${sessionId}` : '');
            const prNumber = context.payload.pull_request?.number || context.payload.issue?.number;
            if (!prNumber) {
              core.warning('No PR number found in payload — cannot post session started comment');
              return;
            }
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: prNumber,
              body: `🔧 **Jules auto-fix session started.** The fix PR will appear shortly.\n\n<!-- jules-auto-fix -->\n<!-- head_sha: ${headSha} -->\n<!-- session: ${sessionResource} -->`,
            });

      - name: Poll planning session (with one retry on failure)
        id: poll-planning
        if: steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.skip != 'true'
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
          SESSION_NAME: ${{ steps.create.outputs.session_name }}
          SESSION_ID: ${{ steps.create.outputs.session_id }}
          HEAD_SHA: ${{ steps.fork-check.outputs.head_sha }}
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ steps.fork-check.outputs.pr_number }}
        run: |
          SESSION_RESOURCE="${SESSION_NAME:-sessions/${SESSION_ID}}"
          if [ -z "$SESSION_RESOURCE" ] || [ "$SESSION_RESOURCE" = "sessions/" ]; then
            echo "final_state=ERROR" >> "$GITHUB_OUTPUT"
            echo "No session resource to poll" >&2
            exit 0
          fi

          poll_session() {
            local resource="$1" max_attempts="$2" label="$3" deadline_s="$4"
            local consecutive_failures=0 state response elapsed remaining
            local start_time=$SECONDS
            for i in $(seq 1 "$max_attempts"); do
              elapsed=$((SECONDS - start_time))
              if [ -n "$deadline_s" ] && [ "$elapsed" -ge "$deadline_s" ]; then
                echo "$label — wall-clock deadline (${deadline_s}s) reached after ${elapsed}s" >&2
                break
              fi
              remaining=$((deadline_s - elapsed))
              [ "$remaining" -lt 15 ] && remaining=15
              [ "$remaining" -gt 60 ] && remaining=60
              sleep 15
              response=$(curl -sS --fail-with-body --connect-timeout 10 --max-time "$remaining" \
                "https://jules.googleapis.com/v1alpha/${resource}" \
                -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>/dev/null) || {
                consecutive_failures=$((consecutive_failures + 1))
                echo "$label attempt $i/$max_attempts — GET failed (consecutive: $consecutive_failures)" >&2
                if [ "$consecutive_failures" -ge 5 ]; then
                  printf '%s' "TRANSPORT_FAILURE"
                  return 0
                fi
                continue
              }
              consecutive_failures=0
              state=$(printf '%s' "$response" | jq -r '.state // "UNKNOWN"')
              if [ "$state" = "COMPLETED" ] || [ "$state" = "FAILED" ] || [ "$state" = "AWAITING_USER_FEEDBACK" ]; then
                printf '%s' "$state"
                return 0
              fi
              echo "$label attempt $i/$max_attempts — state: $state (elapsed: ${elapsed}s)" >&2
            done
            printf '%s' "TIMEOUT"
          }

          STATE=$(poll_session "$SESSION_RESOURCE" 40 "planning" 1200)
          ATTEMPT=1

          if [ "$STATE" = "FAILED" ]; then
            echo "Planning session FAILED — fetching error context" >&2
            ERROR_CONTEXT=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
              "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}/activities?pageSize=50" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>/dev/null \
              | jq -r '[.activities[]? | select(.agentMessaged.agentMessage != null) | .agentMessaged.agentMessage] | last // "No error message captured"' 2>/dev/null || echo "Failed to fetch error context")
            printf '%s' "$ERROR_CONTEXT" > /tmp/jules-planning-error.txt

            # Dedup: skip if a retry marker already exists for this SHA
            # Fail closed: if comment retrieval fails, skip retry rather than risk duplicate
            if ! COMMENT_BODIES=$(gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
              --paginate -q '.[].body' 2>/dev/null); then
              echo "Could not retrieve PR comments for dedup check — skipping retry" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            EXISTING_RETRY=$(printf '%s' "$COMMENT_BODIES" | grep -c "<!-- jules-auto-fix-retry head_sha: ${HEAD_SHA} -->" || true)
            if [ "${EXISTING_RETRY:-0}" -gt 0 ]; then
              echo "Retry already attempted for this SHA — not creating another" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi

            # Build retry payload with error context prepended
            jq --arg ctx "$ERROR_CONTEXT" \
              '.prompt = ("## Retry: Previous planning session failed\n\nThe previous Jules planning session failed with this error:\n\n" + $ctx + "\n\n---\n\n## Original task\n\n" + .prompt)' \
              /tmp/jules-auto-fix-payload.json > /tmp/jules-auto-fix-retry-payload.json

            set +e
            RETRY_RESPONSE=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 -X POST \
              "https://jules.googleapis.com/v1alpha/sessions" \
              -H "Content-Type: application/json" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}" \
              -d @/tmp/jules-auto-fix-retry-payload.json)
            RETRY_RC=$?
            set -e
            if [ "$RETRY_RC" -ne 0 ]; then
              echo "Retry session creation failed: $RETRY_RESPONSE" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            RETRY_NAME=$(printf '%s' "$RETRY_RESPONSE" | jq -r '.name // empty')
            RETRY_ID=$(printf '%s' "$RETRY_RESPONSE" | jq -r '.id // empty')
            RETRY_RESOURCE="${RETRY_NAME:-sessions/${RETRY_ID}}"
            ATTEMPT=2
            echo "Retry session created: $RETRY_RESOURCE" >&2

            # Post retry marker (durable dedup signal)
            gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
              -f body="🔄 **Planning session failed — automatic retry started.**<br>Original session: \`$SESSION_RESOURCE\`<br>Retry session: \`$RETRY_RESOURCE\`<!-- jules-auto-fix-retry head_sha: ${HEAD_SHA} -->" \
              2>/dev/null || true

            # Poll retry session
            RETRY_STATE=$(poll_session "$RETRY_RESOURCE" 40 "retry-planning" 600)
            STATE="$RETRY_STATE"
            SESSION_RESOURCE="$RETRY_RESOURCE"
          fi

          echo "final_state=$STATE" >> "$GITHUB_OUTPUT"
          echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
          echo "attempt=$ATTEMPT" >> "$GITHUB_OUTPUT"

      - name: Post planning session result
        if: always() && steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.skip != 'true'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const state = '${{ steps.poll-planning.outputs.final_state }}';
            const resource = '${{ steps.poll-planning.outputs.session_resource }}';
            const attempt = '${{ steps.poll-planning.outputs.attempt }}';
            const headSha = '${{ steps.fork-check.outputs.head_sha }}';
            const prNumber = context.payload.pull_request?.number || context.payload.issue?.number;
            if (!prNumber) {
              core.warning('No PR number found in payload — cannot post planning result comment');
              return;
            }

            let errorContext = '';
            try { errorContext = fs.readFileSync('/tmp/jules-planning-error.txt', 'utf8').replace(/-->/g, '--\\>'); } catch {}

            const marker = `<!-- jules-auto-fix-result -->`;
            const meta = `<!-- head_sha: ${headSha} --><!-- session: ${resource} --><!-- state: ${state} --><!-- attempt: ${attempt} -->`;

            let body;
            if (!state && !resource) {
              body = `❌ **Jules planning session was not created or polling was skipped.**\n\nThe PR is **not closed**. To retry, push a new commit or re-apply the \`jules-fix\` label.\n\n${marker}\n${meta}`;
            } else if (state === 'COMPLETED') {
              body = `✅ **Jules planning session completed.** The plan should appear as a separate comment above.\n\n${marker}\n${meta}`;
            } else if (state === 'FAILED' || state === 'FAILED_NO_RETRY') {
              body = `❌ **Jules planning session failed${attempt === '2' ? ' (after retry)' : ''}.**\n\nSession: \`${resource}\`\n${errorContext ? `\n> ${errorContext.slice(0, 500).split('\n').join('\n> ')}\n` : ''}\nThe PR is **not closed**. To retry, push a new commit or re-apply the \`jules-fix\` label.\n\n${marker}\n${meta}`;
            } else if (state === 'AWAITING_USER_FEEDBACK') {
              body = `⏳ **Jules planning session is awaiting user feedback.**\n\nSession: \`${resource}\`\n\n${marker}\n${meta}`;
            } else if (state === 'TIMEOUT') {
              body = `⏱️ **Jules planning session timed out (still running).**\n\nSession: \`${resource}\`\nThe session may still produce a plan. Check the session status manually.\n\n${marker}\n${meta}`;
            } else if (state === 'TRANSPORT_FAILURE') {
              body = `⚠️ **Could not poll planning session — repeated API failures.**\n\nSession: \`${resource}\`\nThe session may still be running. Check the session status manually.\n\n${marker}\n${meta}`;
            } else {
              body = `⚠️ **Planning session poll ended with state: ${state || 'UNKNOWN'}.**\n\nSession: \`${resource || 'unknown'}\`\n\n${marker}\n${meta}`;
            }
            await github.rest.issues.createComment({
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: prNumber, body,
            });

      - name: Notify session cap reached
        if: steps.create.outputs.quota_exhausted == 'true'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.pull_request?.number || context.payload.issue.number,
              body: '⚠️ **Jules session cap reached (15/day).**\n\nAuto-fix cannot run today. Re-apply the `jules-fix` label tomorrow to retry.\n\n<!-- jules-quota-exhausted -->',
            });

      - name: Upload session payload
        if: always() && steps.prepare.outputs.skip != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: jules-auto-fix-${{ github.event.pull_request.number || github.event.issue.number }}
          path: /tmp/jules-auto-fix-payload.json
          retention-days: 30

      - name: Skip (fork)
        if: steps.prepare.outputs.skip == 'true'
        shell: bash
        run: echo "Skipped — fork PR (no secret access)"

  # ─── Plan/Approve: handles /approve and /deny comments ──────────────────────

  approve:
    if: >-
      github.event_name == 'issue_comment' &&
      (github.event.comment.body == '/approve' ||
       startsWith(github.event.comment.body, '/approve ') ||
       github.event.comment.body == '/deny' ||
       startsWith(github.event.comment.body, '/deny ')) &&
      github.event.issue.pull_request &&
      contains('OWNER,MEMBER,COLLABORATOR', github.event.comment.author_association)
    runs-on: ubuntu-latest
    timeout-minutes: 35
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Validate approver authorization
        uses: actions/github-script@v7
        with:
          script: |
            const assoc = context.payload.comment.author_association;
            core.info(`Approver association: ${assoc}`);

      - name: Find pending plan and fetch PR context
        id: plan
        uses: actions/github-script@v7
        with:
          script: |
            const prNumber = context.payload.issue.number;
            const comments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: prNumber, per_page: 100,
            });
            // Find the most recent pending plan, excluding denied/stale plans
            const planComment = comments
              .filter(c =>
                c.body?.includes('<!-- jules-auto-fix-plan -->') &&
                !c.body?.includes('<!-- jules-auto-fix-plan-denied -->') &&
                !c.body?.includes('<!-- jules-auto-fix-plan-stale -->')
              )
              .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))[0];
            if (!planComment) {
              core.info('No pending plan comment found — nothing to approve/deny');
              core.setOutput('skip', 'true');
              return;
            }
            const pr = (await github.rest.pulls.get({
              owner: context.repo.owner, repo: context.repo.repo,
              pull_number: prNumber,
            })).data;

            // Extract plan SHA from the plan comment body
            const planShaMatch = planComment.body.match(/HEAD SHA:\s*([a-f0-9]{7,40})/i);
            const planSha = planShaMatch ? planShaMatch[1] : null;

            // SHA pin: if the plan recorded a HEAD SHA and it doesn't match
            // the current PR head, the plan is stale — reject the approval.
            if (planSha && planSha !== pr.head.sha && !pr.head.sha.startsWith(planSha) && !planSha.startsWith(pr.head.sha.slice(0, planSha.length))) {
              core.info(`Plan SHA ${planSha} does not match current head ${pr.head.sha} — plan is stale`);
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                body: `⚠️ **Plan is stale — PR was updated since the plan was posted.**\n\nThe plan was created against commit \`${planSha}\`, but the PR head is now \`${pr.head.sha}\`.\n\nPlease re-apply the \`jules-fix\` label to generate a new plan for the current commit.\n\n<!-- jules-auto-fix-plan-stale -->`,
              });
              core.setOutput('skip', 'true');
              return;
            }

            core.setOutput('skip', 'false');
            core.setOutput('head_sha', pr.head.sha);
            core.setOutput('head_ref', pr.head.ref);
            core.setOutput('base_ref', pr.base.ref);
            core.setOutput('target', pr.base.ref);
            core.setOutput('plan_comment_id', String(planComment.id));
            core.info('Found pending plan comment' + (planSha ? ` (SHA match: ${planSha})` : ' (no SHA in plan)'));

      - name: Handle /deny
        if: startsWith(github.event.comment.body, '/deny') && steps.plan.outputs.skip != 'true'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.issue.number,
              body: '❌ **Jules auto-fix plan denied by maintainer.**\n\nThe plan will not be executed. Re-apply the `jules-fix` label to restart.\n\n<!-- jules-auto-fix-plan-denied -->',
            });

      - name: Checkout PR head
        if: startsWith(github.event.comment.body, '/approve') && steps.plan.outputs.skip != 'true'
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.plan.outputs.head_sha }}
          fetch-depth: 1

      - name: Checkout trusted classifier
        if: startsWith(github.event.comment.body, '/approve') && steps.plan.outputs.skip != 'true'
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.plan.outputs.base_ref }}
          path: _helpers
          sparse-checkout: .github/scripts

      - name: Prepare execution payload
        id: prepare
        if: startsWith(github.event.comment.body, '/approve') && steps.plan.outputs.skip != 'true'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const headSha = '${{ steps.plan.outputs.head_sha }}';
            const planCid = '${{ steps.plan.outputs.plan_comment_id }}';
            const target = '${{ steps.plan.outputs.target }}';
            const prNumber = context.payload.issue.number;

            // Fetch the plan comment body to include as context
            const planComment = await github.rest.issues.getComment({
              owner: context.repo.owner, repo: context.repo.repo,
              comment_id: planCid,
            });
            const planBody = planComment.data.body;

            const prompt = [
              `## Executor: Implement the Approved Plan`,
              ``,
              `A maintainer approved the plan posted below. Implement the fix`,
              `by following the plan step by step.`,
              ``,
              `## Approved Plan (from PR comment)`,
              planBody,
              ``,
              `## PR Context`,
              `Target branch: ${target}`,
              `PR head branch: ${{ steps.plan.outputs.head_ref }}`,
              `PR head SHA: ${headSha}`,
              ``,
              `## Strategy`,
              `The repo is cloned in your sandbox with the PR head branch checked out.`,
              `1. Review the plan above — identify the files to modify`,
              `2. Read existing PR/review comments for additional context`,
              `3. Apply fixes file by file`,
              `4. Run tests`,
              `5. Commit and create a new PR with gh`,
              `6. Post a summary comment with marker <!-- jules-auto-fix-summary -->`,
            ].join('\n');

            const payload = {
              prompt,
              sourceContext: {
                source: `sources/github/${context.repo.owner}/${context.repo.repo}`,
                githubRepoContext: { startingBranch: '${{ steps.plan.outputs.head_ref }}' },
              },
            };
            fs.writeFileSync('/tmp/jules-approve-payload.json', JSON.stringify(payload));
            core.setOutput('target_branch', target);

      - name: Invoke Jules for execution
        id: create
        if: steps.prepare.outputs.target_branch
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
        run: |
          retry_curl() {
            local attempt response rc
            for attempt in 1 2 3; do
              response=$(curl "$@")
              rc=$?
              if [ $rc -eq 0 ]; then printf '%s' "$response"; return 0; fi
              [ $attempt -eq 3 ] || sleep $((attempt * 5))
            done
            printf '%s' "$response"
            return $rc
          }
          set +e
          RESPONSE=$(retry_curl -sS --fail-with-body --connect-timeout 10 --max-time 60 -X POST "https://jules.googleapis.com/v1alpha/sessions" \
            -H "Content-Type: application/json" \
            -H "X-Goog-Api-Key: ${JULES_API_KEY}" \
            -d @/tmp/jules-approve-payload.json)
          CURL_EXIT=$?
          set -e

          if [ $CURL_EXIT -ne 0 ]; then
            ERROR_CODE=$(echo "$RESPONSE" | jq -r '.error.code // "0"')
            ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // ""')
            if [ "$ERROR_CODE" = "429" ] || echo "$ERROR_MSG" | grep -qi 'quota'; then
              echo "quota_exhausted=true" >> "$GITHUB_OUTPUT"
              echo "⚠️ Session cap reached — no session created."
              exit 0
            fi
            if [ "$ERROR_CODE" = "403" ]; then echo "Warning: Jules API returned 403 (not treated as quota)."; fi
            echo "Error: $RESPONSE"
            exit 1
          fi

          SESSION_NAME=$(echo "$RESPONSE" | jq -r '.name // empty')
          SESSION_ID=$(echo "$RESPONSE" | jq -r '.id // empty')
          if [ -z "$SESSION_NAME" ] && [ -z "$SESSION_ID" ]; then
            echo "Error: $RESPONSE"
            exit 1
          fi
          echo "session_name=$SESSION_NAME" >> "$GITHUB_OUTPUT"
          echo "session_id=$SESSION_ID" >> "$GITHUB_OUTPUT"
          echo "Session created: ${SESSION_NAME:-sessions/${SESSION_ID}}"

      - name: Post execution-started comment
        if: steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.target_branch
        uses: actions/github-script@v7
        with:
          script: |
            const headSha = '${{ steps.plan.outputs.head_sha }}';
            const sessionName = '${{ steps.create.outputs.session_name }}';
            const sessionId = '${{ steps.create.outputs.session_id }}';
            const sessionResource = sessionName || (sessionId ? `sessions/${sessionId}` : '');
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.issue.number,
              body: `🔧 **Plan approved — Jules execution session started.**\n\n<!-- jules-auto-fix -->\n<!-- head_sha: ${headSha} -->\n<!-- session: ${sessionResource} -->`,
            });

      - name: Poll execution session (with one retry on failure)
        id: poll-execution
        if: steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.target_branch
        shell: bash
        env:
          JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
          SESSION_NAME: ${{ steps.create.outputs.session_name }}
          SESSION_ID: ${{ steps.create.outputs.session_id }}
          HEAD_SHA: ${{ steps.plan.outputs.head_sha }}
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ github.event.issue.number }}
        run: |
          SESSION_RESOURCE="${SESSION_NAME:-sessions/${SESSION_ID}}"
          if [ -z "$SESSION_RESOURCE" ] || [ "$SESSION_RESOURCE" = "sessions/" ]; then
            echo "final_state=ERROR" >> "$GITHUB_OUTPUT"
            echo "No session resource to poll" >&2
            exit 0
          fi

          poll_session() {
            local resource="$1" max_attempts="$2" label="$3" deadline_s="$4"
            local consecutive_failures=0 state response elapsed remaining
            local start_time=$SECONDS
            for i in $(seq 1 "$max_attempts"); do
              elapsed=$((SECONDS - start_time))
              if [ -n "$deadline_s" ] && [ "$elapsed" -ge "$deadline_s" ]; then
                echo "$label — wall-clock deadline (${deadline_s}s) reached after ${elapsed}s" >&2
                break
              fi
              remaining=$((deadline_s - elapsed))
              [ "$remaining" -lt 15 ] && remaining=15
              [ "$remaining" -gt 60 ] && remaining=60
              sleep 15
              response=$(curl -sS --fail-with-body --connect-timeout 10 --max-time "$remaining" \
                "https://jules.googleapis.com/v1alpha/${resource}" \
                -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>/dev/null) || {
                consecutive_failures=$((consecutive_failures + 1))
                echo "$label attempt $i/$max_attempts — GET failed (consecutive: $consecutive_failures)" >&2
                if [ "$consecutive_failures" -ge 5 ]; then
                  printf '%s' "TRANSPORT_FAILURE"
                  return 0
                fi
                continue
              }
              consecutive_failures=0
              state=$(printf '%s' "$response" | jq -r '.state // "UNKNOWN"')
              if [ "$state" = "COMPLETED" ] || [ "$state" = "FAILED" ] || [ "$state" = "AWAITING_USER_FEEDBACK" ]; then
                printf '%s' "$state"
                return 0
              fi
              echo "$label attempt $i/$max_attempts — state: $state (elapsed: ${elapsed}s)" >&2
            done
            printf '%s' "TIMEOUT"
          }

          STATE=$(poll_session "$SESSION_RESOURCE" 60 "execution" 1500)
          ATTEMPT=1

          if [ "$STATE" = "FAILED" ]; then
            echo "Execution session FAILED — fetching error context" >&2
            ERROR_CONTEXT=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 \
              "https://jules.googleapis.com/v1alpha/${SESSION_RESOURCE}/activities?pageSize=50" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}" 2>/dev/null \
              | jq -r '[.activities[]? | select(.agentMessaged.agentMessage != null) | .agentMessaged.agentMessage] | last // "No error message captured"' 2>/dev/null || echo "Failed to fetch error context")
            printf '%s' "$ERROR_CONTEXT" > /tmp/jules-execution-error.txt

            # Dedup: skip if a retry marker already exists for this SHA
            # Fail closed: if comment retrieval fails, skip retry rather than risk duplicate
            if ! COMMENT_BODIES=$(gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
              --paginate -q '.[].body' 2>/dev/null); then
              echo "Could not retrieve PR comments for dedup check — skipping retry" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            EXISTING_RETRY=$(printf '%s' "$COMMENT_BODIES" | grep -c "<!-- jules-auto-fix-exec-retry head_sha: ${HEAD_SHA} -->" || true)
            if [ "${EXISTING_RETRY:-0}" -gt 0 ]; then
              echo "Retry already attempted for this SHA — not creating another" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi

            # Build retry payload with error context prepended
            jq --arg ctx "$ERROR_CONTEXT" \
              '.prompt = ("## Retry: Previous execution session failed\n\nThe previous Jules execution session failed with this error:\n\n" + $ctx + "\n\n---\n\n## Original approved plan\n\n" + .prompt)' \
              /tmp/jules-approve-payload.json > /tmp/jules-approve-retry-payload.json

            set +e
            RETRY_RESPONSE=$(curl -sS --fail-with-body --connect-timeout 10 --max-time 60 -X POST \
              "https://jules.googleapis.com/v1alpha/sessions" \
              -H "Content-Type: application/json" \
              -H "X-Goog-Api-Key: ${JULES_API_KEY}" \
              -d @/tmp/jules-approve-retry-payload.json)
            RETRY_RC=$?
            set -e
            if [ "$RETRY_RC" -ne 0 ]; then
              echo "Retry session creation failed: $RETRY_RESPONSE" >&2
              echo "final_state=FAILED_NO_RETRY" >> "$GITHUB_OUTPUT"
              echo "attempt=1" >> "$GITHUB_OUTPUT"
              echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            RETRY_NAME=$(printf '%s' "$RETRY_RESPONSE" | jq -r '.name // empty')
            RETRY_ID=$(printf '%s' "$RETRY_RESPONSE" | jq -r '.id // empty')
            RETRY_RESOURCE="${RETRY_NAME:-sessions/${RETRY_ID}}"
            ATTEMPT=2
            echo "Retry session created: $RETRY_RESOURCE" >&2

            # Post retry marker (durable dedup signal)
            gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
              -f body="🔄 **Execution session failed — automatic retry started.**<br>Original session: \`$SESSION_RESOURCE\`<br>Retry session: \`$RETRY_RESOURCE\`<!-- jules-auto-fix-exec-retry head_sha: ${HEAD_SHA} -->" \
              2>/dev/null || true

            # Poll retry session
            RETRY_STATE=$(poll_session "$RETRY_RESOURCE" 60 "retry-execution" 600)
            STATE="$RETRY_STATE"
            SESSION_RESOURCE="$RETRY_RESOURCE"
          fi

          echo "final_state=$STATE" >> "$GITHUB_OUTPUT"
          echo "session_resource=$SESSION_RESOURCE" >> "$GITHUB_OUTPUT"
          echo "attempt=$ATTEMPT" >> "$GITHUB_OUTPUT"

      - name: Post execution session result
        if: always() && steps.create.outputs.quota_exhausted != 'true' && steps.prepare.outputs.target_branch
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const state = '${{ steps.poll-execution.outputs.final_state }}';
            const resource = '${{ steps.poll-execution.outputs.session_resource }}';
            const attempt = '${{ steps.poll-execution.outputs.attempt }}';
            const headSha = '${{ steps.plan.outputs.head_sha }}';

            let errorContext = '';
            try { errorContext = fs.readFileSync('/tmp/jules-execution-error.txt', 'utf8').replace(/-->/g, '--\\>'); } catch {}

            const marker = `<!-- jules-auto-fix-result -->`;
            const meta = `<!-- head_sha: ${headSha} --><!-- session: ${resource} --><!-- state: ${state} --><!-- attempt: ${attempt} -->`;

            let body;
            if (!state && !resource) {
              body = `❌ **Jules execution session was not created or polling was skipped.**\n\nThe PR is **not closed**. To retry, push a new commit or re-apply the \`jules-fix\` label and approve the new plan.\n\n${marker}\n${meta}`;
            } else if (state === 'COMPLETED') {
              body = `✅ **Jules execution session completed.** The fix PR should appear shortly.\n\n${marker}\n${meta}`;
            } else if (state === 'FAILED' || state === 'FAILED_NO_RETRY') {
              body = `❌ **Jules execution session failed${attempt === '2' ? ' (after retry)' : ''}.**\n\nSession: \`${resource}\`\n${errorContext ? `\n> ${errorContext.slice(0, 500).split('\n').join('\n> ')}\n` : ''}\nThe PR is **not closed**. To retry, push a new commit or re-apply the \`jules-fix\` label and approve the new plan.\n\n${marker}\n${meta}`;
            } else if (state === 'AWAITING_USER_FEEDBACK') {
              body = `⏳ **Jules execution session is awaiting user feedback.**\n\nSession: \`${resource}\`\n\n${marker}\n${meta}`;
            } else if (state === 'TIMEOUT') {
              body = `⏱️ **Jules execution session timed out (still running).**\n\nSession: \`${resource}\`\nThe session may still be running. Check the session status manually.\n\n${marker}\n${meta}`;
            } else if (state === 'TRANSPORT_FAILURE') {
              body = `⚠️ **Could not poll execution session — repeated API failures.**\n\nSession: \`${resource}\`\nThe session may still be running. Check the session status manually.\n\n${marker}\n${meta}`;
            } else {
              body = `⚠️ **Execution session poll ended with state: ${state || 'UNKNOWN'}.**\n\nSession: \`${resource || 'unknown'}\`\n\n${marker}\n${meta}`;
            }
            await github.rest.issues.createComment({
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: context.payload.issue.number, body,
            });

      - name: Notify session cap reached
        if: steps.create.outputs.quota_exhausted == 'true'
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.issue.number,
              body: '⚠️ **Jules session cap reached (15/day).**\n\nExecution cannot start today. Comment /approve again tomorrow.\n\n<!-- jules-quota-exhausted -->',
            });

      - name: Upload execution payload
        if: always() && steps.prepare.outputs.target_branch
        uses: actions/upload-artifact@v4
        with:
          name: jules-approve-${{ github.event.issue.number }}
          path: /tmp/jules-approve-payload.json
          retention-days: 30
