# === Notebooks ===
# Exploratory, not production source
notebooks/*.ipynb

# === Binary images ===
# Not lintable by standard tools
*.png
*.svg

# === Diagram source files ===
*.mermaid

# === Lock / package files ===
# Auto-generated, large, not worth linting
**/package-lock.json
**/pnpm-lock.yaml
**/uv.lock
**/yarn.lock

# === Agent-generated plans ===
# Generated by agent sessions, not hand-authored
.kilo/plans/*.md

# === Archived content ===
# Historical, not actively maintained
.JULES_ARCHIVE.md
